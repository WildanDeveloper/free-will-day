# Copy to .env and fill in. Nothing here is read from inside the sandbox by
# default: the agent only needs a model key, and that key should be scoped to
# this experiment only.

# ---------------------------------------------------------------- model
# Base URL is required. Any Anthropic- or OpenAI-shaped endpoint works:
#   https://api.anthropic.com
#   https://openrouter.ai/api
#   http://127.0.0.1:4000        (vLLM, LiteLLM, local gateway)
MODEL_BASE_URL=https://api.anthropic.com
MODEL_API_KEY=
MODEL_ID=claude-sonnet-4-5

# anthropic | openai — selects the wire format, not the vendor.
MODEL_STYLE=anthropic

# Optional basic auth. Set these when the endpoint sits behind a credential
# proxy; when present, Authorization carries Basic auth instead of the key.
MODEL_BASIC_USER=
MODEL_BASIC_PASS=

# USD per 1M tokens. Used to price the usage field the provider returns.
PRICE_INPUT_PER_M=3
PRICE_OUTPUT_PER_M=15

# ---------------------------------------------------------------- paths
WORKSPACE_DIR=/workspace
MEMORY_DIR=/memory
LOGS_DIR=/logs
STOP_FILE=/STOP
STATE_FILE=/memory/state.json

# ---------------------------------------------------------------- limits
RUN_DURATION=24h
MAX_BUDGET_USD=5
SLEEP_MS=2000
CONTEXT_ACTIONS=20
# Actions between real compactions: the recent-action window is summarised into
# journal.md by the model, then dropped.
SUMMARIZE_EVERY=30
JOURNAL_EVERY_MINUTES=60
MAX_TOOL_OUTPUT=4000
SHELL_TIMEOUT_MS=120000

# ---------------------------------------------------------------- browser
# Off by default. When on, Playwright is lazy-loaded and the agent gets a sixth
# tool: browser (open, read, click, type, press, back, screenshot, close).
# One-time setup: npm install && npx playwright install --with-deps chromium
ENABLE_BROWSER=0
BROWSER_PROFILE_DIR=/workspace/.pw
SCREENSHOT_EVERY_MINUTES=5

# ---------------------------------------------------------------- dashboard
# Bind to loopback. Read it through an SSH tunnel, do not expose it.
SUPERVISOR_ADDR=127.0.0.1:8080
TEMPLATE_DIR=web/templates

# Dashboard credentials. With neither set the page is open, loopback only.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
DASHBOARD_TOKEN=

# Set when the dashboard is served over TLS behind a proxy, so POST /stop
# only accepts same-origin submissions.
ALLOWED_ORIGIN=

# ---------------------------------------------------------------- compaction
# Identical consecutive tool calls before the agent is nudged to stop repeating.
# SUMMARIZE_EVERY above is the compaction trigger.
LOOP_DETECTION_THRESHOLD=3

# ---------------------------------------------------------------- alerts
# Optional webhook for run halts, idle, spend spikes, and stuck loops. Works
# with Discord and Telegram out of the box. Leave empty to disable.
ALERT_WEBHOOK_URL=
# Minimum gap between two alerts of the same condition.
ALERT_COOLDOWN=10m

# ---------------------------------------------------------------- watchdog
IDLE_ALERT_MINUTES=15
COST_ALERT_USD=3