{
  "name": "freewillday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous 24 hour agent run, monitored end to end.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "agent": "node cmd/agent/main.ts",
    "supervisor": "go run ./cmd/supervisor",
    "build:supervisor": "go build -o bin/supervisor ./cmd/supervisor",
    "test": "npm run test:unit && npm run test:browser && npm run smoke",
    "test:unit": "node scripts/compaction-test.ts",
    "test:browser": "node scripts/browser-test.ts",
    "smoke": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
